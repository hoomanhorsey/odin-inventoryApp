<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home Page</title>
  </head>

  <body>
    <form action="/item/new" method="POST">

      <h2>
        <label for="bookTitle"> Book title</label>
        <input
          placeholder="Insert title"
          type="text"
          name="bookTitle"
          id="bookTitle"
        />
      </h2>
   
   
        <p>
        <label for="author"
        <input 
          type="text"
          id="author"
          name="authors"
          placeholder="Insert author"
        />
      </p>
      <%
        }) %>

   <label for="pages">Pages</label>
        <input
          placeholder="Insert page no."
          type="numger"
          name="pages"
          id="pages"
        />
       <p>
        <label for="year_published">Year Published</label>
        <input
          placeholder="Insert year published"
          type="number"
          name="year_published"
          id="year_published"
        />
      </p>
      <p>
        <label for="publisher">Publisher</label>
        <input
          value="Insert publisher name"
          type="text"
          name="publisher_name"
          id="publisher_name"
        />
      </p>

         <p>
        <label for="publisher_country">Publisher Country</label>
        <input
          placeholder="insert publisher name"
          type="text"
          name="publisher_country"
          id="publisher_country"
        />
      </p>

  <p>
    <label for="genre">Genre </label>
    <input
      type="text"
      id="genre-<%= index %>"
      name="genres[]"
      placeholder="Insert genre"
    />
  </p>
<% }) %>

      <button type="submit">Submit updates</button>
    </form>

     </body>
</html>
