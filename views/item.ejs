<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home Page</title>
  </head>
  <body>
    <h2>Title: <%= bookItem.title %></h2>
    <p>[book_id: <%= bookId %>]</p>

    <p>Author(s): <%= bookItem.authors.join(', ') %></p>

    <p>Pages: <%= bookItem.pages %></p>

    <p>
      Published: <%= bookItem.year_published%> || Publisher: <%=
      bookItem.publisher_name%> || Country: <%= bookItem.publisher_country%>
    </p>
  
    <p>
    Genre: <%- bookItem.genres.map(genre => `<a href="/genre/${encodeURIComponent(genre)}">${genre}</a>`).join(', ') %>
    </p>

    <p><a href="/item/<%= bookItem.book_id%>/update" class="btn">Update</a>

    <a href="/delete/bookItem.book_id %> ">Delete book</a></p>

<p> <a href="/">Return to index</a></p>
  
  </body>
</html>
