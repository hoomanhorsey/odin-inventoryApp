<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home Page</title>
  </head>
  <body>
    "Hello this is the complete library  template" 

    <ul>
  <% books.map((book) => { %>
    <li>Book Title: "<%= book.title %>" || Pages: <%= book.pages %> ||
    
    Published: <%= book.year_published %> || 
    Publisher:  <%= book.publisher_name %> 


    
    </li>
  <% }) %>
</ul>
  </body>
</html>
