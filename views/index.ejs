<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home Page</title>
  </head>
  <body>
    "Hello this is the complete library  template" 

    <ul>
      <% records.map((record) => { %>
        <li>
           Title:
          "<a href="/item/<%= record.book_id %>">
          <%= record.title %>
         </a>" ||
          Author(s): <%= record.authors.join(', ')  %> ||
          Year: <%= record.year_published %> 
    
          </li>
      <% }) %>
  </ul>

      <p><a href="/new" class="btn">Add new book</a></p>

  </body>
</html>
