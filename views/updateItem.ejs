<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home Page</title>
  </head>

  <body>
    <form action="/item/<%= bookItem.book_id %>/update" method="POST">

      <h2>
        <label for="bookTitle"> Book title</label>
        <input
          value="<%= bookItem.title %>"
          type="text"
          name="bookTitle"
          id="bookTitle"
        />
      </h2>
   
        <% bookItem.authors.forEach((author, index) => { %>
        <p>
        <label for="author -<%= index %>">Author <%= index + 1 %></label>
        <input 
          type="text"
          id="author-<%= index %>"
          name="authors[]"
          value="<%= author %>"
        />
      </p>
      <%
        }) %>


       <p>
        <label for="year_published">Year Published</label>
        <input
          value="<%= bookItem.year_published %>"
          type="number"
          name="year_published"
          id="year_published"
        />
      </p>
      <p>
        <label for="publisher">Publisher</label>
        <input
          value="<%= bookItem.publisher_name%>"
          type="text"
          name="publisher"
          id="publisher"
        />
      </p>

         <p>
        <label for="publisher_country">Publisher</label>
        <input
          value="<%= bookItem.publisher_country%>"
          type="text"
          name="publisher_country"
          id="publisher_country"
        />
      </p>
<% bookItem.genres.forEach((genre, index) => { %>
  <p>
    <label for="genre-<%= index %>">Genre <%= index + 1 %></label>
    <input
      type="text"
      id="genre-<%= index %>"
      name="genres[]"
      value="<%= genre %>"
    />
  </p>
<% }) %>



      <button type="submit">Submit updates</button>
    </form>

   
</html>
